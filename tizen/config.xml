<?xml version="1.0" encoding="UTF-8"?>
<!-- tizen/build.mjs fills in the version from package.json. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://seanime.app/tenji" version="{{VERSION}}">
    <tizen:application id="SnmTenjiTV.SeanimeTenji" package="SnmTenjiTV" required_version="6.5"/>
    <tizen:profile name="tv"/>
    <name>Seanime Tenji</name>
    <description>Seanime for your TV</description>
    <icon src="icon.png"/>
    <content src="index.html"/>
    <!-- The server is on the LAN at an address the user types in. -->
    <access origin="*" subdomains="true"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <!-- hwkey-event: Back reaches the page as keyCode 10009. -->
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
